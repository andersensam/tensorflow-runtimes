build --action_env PYTHON_BIN_PATH="/opt/python3.12/bin/python3.12"
build --action_env PYTHON_LIB_PATH="/opt/venv/lib/python3.12/site-packages"
build --python_path="/opt/python3.12/bin/python3.12"
build --repo_env HERMETIC_PYTHON_VERSION=3.12
build:cuda --repo_env HERMETIC_CUDA_VERSION="12.9.2"
build:cuda --repo_env HERMETIC_CUDNN_VERSION="9.8.0"
build:cuda --repo_env HERMETIC_CUDA_COMPUTE_CAPABILITIES="compute_90,compute_100,compute_101,compute_103,compute_120,sm_90a,sm_100a,sm_101a,sm_103,sm_103a,sm_120a"
build --action_env LD_LIBRARY_PATH="/usr/local/cuda/lib64"
build --config=cuda_clang
build --config=avx_linux
build --config=clang_local
build --action_env CLANG_CUDA_COMPILER_PATH="/opt/llvm/bin/clang"
build --action_env CPP_PATH="/opt/llvm/bin/clang++"
build --action_env CXX="/opt/llvm/bin/clang++"
build --action_env GCC_PATH="/opt/llvm/bin/clang"
build --action_env CC="/opt/llvm/bin/clang"
build --action_env CLANG_COMPILER_PATH="/opt/llvm/bin/clang"
build:linux --repo_env=LLVM_VERSION=20
build:linux --repo_env=SYSROOT_DIST=linux_glibc_2_35
build:opt --copt=-Wno-sign-compare
build:opt --host_copt=-Wno-sign-compare
build --copt=-DHWY_DISABLED_TARGETS=511
build --host_copt=-DHWY_DISABLED_TARGETS=511
test --test_size_filters=small,medium
test --test_env=LD_LIBRARY_PATH
test:v1 --test_tag_filters=-benchmark-test,-no_oss,-oss_excluded,-no_gpu,-oss_serial
test:v1 --build_tag_filters=-benchmark-test,-no_oss,-oss_excluded,-no_gpu
test:v2 --test_tag_filters=-benchmark-test,-no_oss,-oss_excluded,-no_gpu,-oss_serial,-v1only
test:v2 --build_tag_filters=-benchmark-test,-no_oss,-oss_excluded,-no_gpu,-v1only
